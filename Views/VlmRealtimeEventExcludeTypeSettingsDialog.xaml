<UserControl x:Class="FaceSearchApp.Views.VlmRealtimeEventExcludeTypeSettingsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             Width="560">
    <StackPanel Margin="0,4,0,0">
        <TextBlock Margin="0,0,0,12"
                   FontSize="12"
                   Opacity="0.65"
                   Text="Key가 MQTT 이벤트 타입 문자열에 포함되면 우측 실시간 이벤트 리스트에 표시하지 않습니다." />

        <DataGrid x:Name="ExcludeTypeGrid"
                  Margin="0,0,0,12"
                  MinHeight="220"
                  MaxHeight="360"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  Background="{DynamicResource ApplicationBackgroundBrush}"
                  ItemsSource="{Binding}"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Width="*"
                                    Binding="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Header="Key" />
                <DataGridTextColumn Width="*"
                                    Binding="{Binding Display, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Header="표시명" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox x:Name="KeyBox"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        PlaceholderText="Key" />

            <ui:TextBox x:Name="DisplayBox"
                        Grid.Column="1"
                        Margin="0,0,8,0"
                        PlaceholderText="표시명" />

            <ui:Button Grid.Column="2"
                       Margin="0,0,8,0"
                       Click="AddButton_Click"
                       Content="추가"
                       Icon="{ui:SymbolIcon Add24}" />

            <ui:Button Grid.Column="3"
                       Appearance="Secondary"
                       Click="DeleteButton_Click"
                       Content="삭제"
                       Icon="{ui:SymbolIcon Delete24}" />
        </Grid>

        <Border Margin="0,0,0,12"
                Padding="10,8"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="6">
            <StackPanel>
                <CheckBox x:Name="ShowNegativeConfidenceBox"
                          Margin="0,0,0,8"
                          Content="Confidence 값이 음수인 실시간 이벤트도 리스트에 표시"
                          VerticalAlignment="Center" />
                <CheckBox x:Name="UseRealtimeDelayBox"
                          Margin="0,0,0,8"
                          Content="분석 완료 후 다음 실시간 VLM 분석까지 딜레이 적용"
                          VerticalAlignment="Center" />
                <Grid Margin="22,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Opacity="0.75"
                               Text="딜레이" />
                    <ui:NumberBox x:Name="DelaySecondsBox"
                                  Grid.Column="1"
                                  Minimum="0"
                                  Maximum="600"
                                  SpinButtonPlacementMode="Compact" />
                    <TextBlock Grid.Column="2"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Opacity="0.75"
                               Text="초" />
                </Grid>
                <CheckBox x:Name="SkipAnalysisWhenBusyBox"
                          Content="이미 VLM 분석 중이면 새 실시간 이벤트의 VLM 분석 생략"
                          VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <TextBlock FontSize="12"
                   Opacity="0.65"
                   Text="기본값은 음수 Confidence 이벤트를 무시하고, 2초 딜레이를 적용하며, 분석 중 새 이벤트의 VLM 분석을 생략합니다." />
    </StackPanel>
</UserControl>
