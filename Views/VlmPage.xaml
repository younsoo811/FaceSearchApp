<Page x:Class="FaceSearchApp.Views.VlmPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FaceSearchApp.Views"
      xmlns:converters="clr-namespace:FaceSearchApp.Converters"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1500"
      Title="VLM 이미지 분석">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullVis" />
        <converters:NotNullToVisibilityConverter x:Key="NotNullVis" />
    </Page.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="300" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- 좌측 패널: 설정 + 이미지 선택                        -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- MQTT 설정 카드 -->
            <ui:Card Grid.Row="0">
                <Expander
                    IsExpanded="True"
                    ExpandDirection="Down">
                    <Expander.Header>
                        <Border Padding="0,0,0,4">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="VLM 서버 연결 설정" />
                        </Border>
                    </Expander.Header>

                    <StackPanel>
                        <StackPanel Margin="0 0 0 10">
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="서버 주소" />
                            <ui:TextBox
                                PlaceholderText="예: 192.168.1.100"
                                Text="{Binding Broker, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Margin="0 0 0 10">
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="포트" />
                            <ui:NumberBox
                                Maximum="65535"
                                Minimum="1"
                                Value="{Binding Port}" />
                        </StackPanel>

                        <StackPanel Margin="0 0 0 10">
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Publish 토픽" />
                            <ui:TextBox
                                PlaceholderText="예: vlm/request"
                                Text="{Binding PubTopic, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Margin="0 0 0 10">
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Subscribe 토픽" />
                            <ui:TextBox
                                PlaceholderText="예: vlm/response"
                                Text="{Binding SubTopic, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <ui:ToggleSwitch
                            Margin="0 0 0 10"
                            Content="서버 인증 사용"
                            IsChecked="{Binding UseCredentials}" />

                        <StackPanel
                            Margin="0 0 0 10"
                            Visibility="{Binding UseCredentials, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="0 0 0 10">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="아이디" />
                                <ui:TextBox
                                    PlaceholderText="서버 아이디"
                                    Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="0 0 0 10">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="비밀번호" />
                                <ui:PasswordBox
                                    x:Name="PasswordBox"
                                    PlaceholderText="서버 비밀번호"
                                    VerticalContentAlignment="Center"
                                    Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>

                        <Border
                            Margin="0 0 0 5"
                            Padding="8,6"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#E74C3C" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="#2ECC71" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Text="{Binding ConnectionStatus}"
                                        TextTrimming="CharacterEllipsis" />

                                    <TextBlock Margin="5 0 1 0" FontSize="8" Text="[" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock
                                        Margin="0 0 0 0"
                                        FontSize="8"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding StatusMessage}" />
                                    <TextBlock Margin="1 0 0 0" FontSize="8" Text="]" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ui:Button
                            HorizontalAlignment="Stretch"
                            Command="{Binding ToggleConnectionCommand}"
                            Content="{Binding ConnectButtonText}">
                            <ui:Button.Style>
                                <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                    <Setter Property="Appearance" Value="Primary" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Appearance" Value="Secondary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>
                </Expander>
            </ui:Card>

            <!-- 이미지 드롭존 -->
            <Grid Grid.Row="2">
                <ui:Card Grid.Row="2" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock
                            Margin="0,0,0,12"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="이미지 업로드" />

                        <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Center">
                            <Border
                                x:Name="QueryDropZone"
                                Margin="0 0 0 12"
                                MinHeight="160"
                                MaxHeight="160"
                                AllowDrop="True"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="2"
                                CornerRadius="8"
                                Cursor="Hand"
                                DragLeave="QueryZone_DragLeave"
                                DragOver="QueryZone_DragOver"
                                Drop="QueryZone_Drop"
                                MouseLeftButtonDown="QueryZone_Click">
                                <Grid>
                                    <!--  실제 이미지  -->
                                    <Image
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        Source="{Binding QueryImage}"
                                        Stretch="Uniform"
                                        Visibility="{Binding QueryImage, Converter={StaticResource NullVis}}" />

                                    <!--  이미지 드래그&드롭  -->
                                    <Border Visibility="{Binding QueryImage, Converter={StaticResource NotNullVis}}">
                                        <StackPanel
                                            Margin="20"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                            <ui:SymbolIcon
                                                HorizontalAlignment="Center"
                                                FontSize="52"
                                                Opacity="0.35"
                                                Symbol="ImageAdd24"/>
                                            <TextBlock
                                                Margin="0,12,0,4"
                                                HorizontalAlignment="Center"
                                                FontSize="13"
                                                Opacity="0.6"
                                                Text="여기에 이미지를 드래그" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="12"
                                                Opacity="0.45"
                                                Text="또는 클릭하여 선택" />
                                            <!--<TextBlock
                                                    Margin="0,8,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="11"
                                                    Opacity="0.35"
                                                    Text="JPG · PNG · BMP · WEBP" />-->
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!--  이미지 정보  -->
                            <TextBlock
                                Grid.Row="3"
                                Margin="10,0"
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Opacity="0.55"
                                Text="{Binding ImageInfo}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding QueryImage, Converter={StaticResource NullVis}}" />

                            <!--  버튼  -->
                            <StackPanel
                                Grid.Row="4"
                                Margin="0,0,0,12"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                >
                                <ui:Button
                                    Click="SelectFile_Click"
                                    Content="파일 선택"
                                    Icon="{ui:SymbolIcon FolderOpen24}" Margin="5 0 5 0"/>
                                <ui:Button
                                    Command="{Binding ClearQueryCommand}"
                                    Content="초기화"
                                    Icon="{ui:SymbolIcon Dismiss24}"
                                    Visibility="{Binding QueryImage, Converter={StaticResource NullVis}}" Margin="5 0 5 0"/>
                            </StackPanel>
                        </StackPanel>

                        <!--  제어 버튼  -->
                        <Grid Grid.Row="2" VerticalAlignment="Bottom">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!--<ui:ToggleSwitch
                                Margin="0,0,0,10"
                                Content="화재 여부 표시"
                                IsChecked="{Binding IsFireMode}" />-->
                            <ComboBox
                                Width="120"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Left"
                                ItemsSource="{Binding EventTypes}"
                                SelectedItem="{Binding SelectedEventType, Mode=TwoWay}"
                                DisplayMemberPath="Display"
                                />

                            <ui:ToggleSwitch
                                HorizontalAlignment="Right"
                                Margin="0,0,0,10"
                                Content="분석 연속 요청"
                                IsChecked="{Binding IsContinuousMode}" />
                            <ui:Button
                                Grid.Row="1"
                                Margin="0 0 0 0"
                                Appearance="Primary"
                                Command="{Binding AnalyzeCommand}"
                                Content="분석 요청"
                                HorizontalAlignment="Stretch"
                                Icon="{ui:SymbolIcon Send24}" />
                        </Grid>
                    </Grid>
                </ui:Card>
            </Grid>
        </Grid>

        <!--  스플리터  -->
        <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Center" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- 우측 패널: 분석 결과 히스토리                        -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Grid Grid.Column="2" Margin="10 0 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  제어 버튼  -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12" Orientation="Horizontal" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}">
                <Border>
                    <TextBlock
                        Margin="0,0,10,0"
                        FontSize="20"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="VLM 분석 결과" />
                </Border>

                <!--<Border
                    Padding="10"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="6"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullVis}, TargetNullValue=Collapsed, FallbackValue=Collapsed}">
                    <TextBlock
                        FontSize="11"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding StatusMessage}" />
                </Border>-->

                <ui:Button
                    Margin="10 0 0 0"
                    Appearance="Danger"
                    Command="{Binding CancelAnalysisCommand}"
                    Content="취소"
                    Icon="{ui:SymbolIcon DismissCircle24}"
                    Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <StackPanel Margin="0 0 0 12" Orientation="Horizontal" HorizontalAlignment="Right">
                <Border
                    Margin="0 0 20 0"
                    Padding="7"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="6">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <ui:ToggleSwitch
                            Margin="0,0,12,0"
                            Content="실시간 분석"
                            IsChecked="{Binding IsLiveEventMode}" />

                        <Rectangle Fill="DarkGray" Width="2" Margin="0,0,10,0" />

                        <!-- 미응답 생략 토글 -->
                        <StackPanel Margin="0,0,12,0" Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLiveEventMode}" Value="False">
                                            <Setter Property="Opacity" Value="0.35" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ui:ToggleSwitch
                                Content="미응답 생략"
                                IsChecked="{Binding IsSkipNoResponse}"
                                IsEnabled="{Binding IsLiveEventMode}">
                                <ui:ToggleSwitch.ToolTip>
                                    <TextBlock>
                                        <Run Text="설정한 시간(초) 이내 응답이 없으면 해당 요청을 자동으로 삭제합니다." />
                                    </TextBlock>
                                </ui:ToggleSwitch.ToolTip>
                            </ui:ToggleSwitch>

                            <ui:NumberBox
                                Margin="8,0,0,0"
                                Width="100"
                                Minimum="1"
                                Maximum="600"
                                SpinButtonPlacementMode="Compact"
                                Value="{Binding SkipNoResponseTimeoutSeconds}"
                                IsEnabled="{Binding IsSkipNoResponse}"
                                ToolTip="미응답 생략까지 대기할 시간(초)" />
                            <TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Opacity="0.6"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="초" />
                        </StackPanel>

                        <Rectangle Fill="DarkGray" Width="2" Margin="0 0 10 0"/>

                        <!-- 실시간 분석 ON일 때만 활성화 -->
                        <StackPanel 
                            Orientation="Horizontal"
                            IsEnabled="{Binding IsLiveEventMode}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.35"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <ui:Button
                                Command="{Binding ConfigureEventTypesCommand}"
                                Content="타입 설정"
                                Icon="{ui:SymbolIcon Settings24}" />
                        </StackPanel>

                    </StackPanel>
                </Border>

                <Border
                    Margin="0 0 20 0"
                    Padding="7"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="6">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:ToggleSwitch
                            Margin="0,0,12,0"
                            Content="이상 여부 표시"
                            IsChecked="{Binding IsFireMode}" />
                        <ComboBox
                            Width="120"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Center"
                            ItemsSource="{Binding LabelTypes}"
                            SelectedItem="{Binding SelectedLabelType, Mode=TwoWay}"
                            DisplayMemberPath="Display"
                            />
                    </StackPanel>
                </Border>
                <ui:Button Command="{Binding ClearHistoryCommand}"
                       Appearance="Secondary"
                       Icon="{ui:SymbolIcon Delete24}"
                           ToolTip="분석 기록 초기화"
                       HorizontalAlignment="Right"
                           VerticalAlignment="Stretch"
                       />
            </StackPanel>


            <!--  분석 히스토리  -->
            <Grid Grid.Row="1">
                <ScrollViewer
                    MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AnalysisHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,0,0,12" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--  이미지  -->
                                        <Border Grid.Column="0" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Cursor="Hand">
                                            <!-- 클릭 시 상세 다이얼로그 -->
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                    Command="{Binding DataContext.ShowDetailCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <Grid>
                                                <Image
                                                Margin="5"
                                                RenderOptions.BitmapScalingMode="HighQuality"
                                                Source="{Binding Image}"
                                                Stretch="Uniform" />

                                                <!-- 화재 여부 배지 -->
                                                <Grid Margin="5" VerticalAlignment="Top" HorizontalAlignment="Right" Visibility="{Binding IsAnalyzing, Converter={StaticResource InvBoolToVis}}">
                                                    <Border
                                                        Margin="8,0,0,0"
                                                        Padding="10,5"
                                                        HorizontalAlignment="Left"
                                                        Background="{Binding FireBorderBrush}"
                                                        CornerRadius="6"
                                                        Visibility="{Binding DataContext.IsFireMode, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">

                                                        <TextBlock
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="White"
                                                            Text="{Binding FireLabel}" />
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!--  내용  -->
                                        <StackPanel Grid.Column="2">
                                            <StackPanel Orientation="Horizontal">
                                                <!--  타임스탬프  -->
                                                <TextBlock
                                                    Margin="0 0 0 10"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding Timestamp}" />

                                                <!--  이미지 정보  -->
                                                <TextBlock Margin="10 0 0 0" Text="* 이미지 정보: " FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding ImageInfo}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!--  분석 중 상태  -->
                                            <StackPanel
                                                Margin="0 0 0 10"
                                                HorizontalAlignment="Left"
                                                Orientation="Horizontal"
                                                Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}">
                                                <ui:ProgressRing
                                                    Width="24"
                                                    Height="24"
                                                    IsIndeterminate="True" />
                                                <TextBlock
                                                    Margin="10 0 0 0"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="이미지 분석 중..." />
                                            </StackPanel>

                                            <!--  결과  -->
                                            <StackPanel Visibility="{Binding IsAnalyzing, Converter={StaticResource InvBoolToVis}}">
                                                <StackPanel Margin="0 0 0 10" Orientation="Horizontal">
                                                    <!--  Result  -->
                                                    <Border
                                                        Padding="10,5"
                                                        HorizontalAlignment="Left"
                                                        Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                        CornerRadius="6">
                                                        <TextBlock
                                                            FontSize="12"
                                                            FontWeight="Bold"
                                                            LineHeight="20"
                                                            Foreground="White"
                                                            Text="{Binding Result}" TextWrapping="Wrap"/>
                                                    </Border>
                                                </StackPanel>

                                                <!--  설명  -->
                                                <Border
                                                    Padding="10,8"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                    CornerRadius="6">
                                                    <StackPanel>
                                                        <TextBlock
                                                            Margin="0 0 0 10"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="이미지 설명" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            LineHeight="20"
                                                            Text="{Binding AnimatedDescription}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  빈 상태  -->
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AnalysisHistory.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                </ScrollViewer>
            </Grid>

            <!--  빈 상태 플레이스홀더  -->
            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding AnalysisHistory.Count, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                <ui:SymbolIcon
                    HorizontalAlignment="Center"
                    FontSize="64"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Symbol="ImageSearch24" />
                <TextBlock
                    FontSize="15"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="이미지를 선택하고 분석을 시작하세요" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
