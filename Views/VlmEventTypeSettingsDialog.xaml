<UserControl x:Class="FaceSearchApp.Views.VlmEventTypeSettingsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             Width="620">
    <StackPanel Margin="0,4,0,0">
        <TextBlock Margin="0,0,0,12"
                   FontSize="12"
                   Opacity="0.65"
                   Text="Key는 MQTT 이벤트 타입 문자열에 포함되는 값입니다." />

        <DataGrid x:Name="EventTypeGrid"
                  Margin="0,0,0,12"
                  MinHeight="220"
                  MaxHeight="360"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  Background="{DynamicResource ApplicationBackgroundBrush}"
                  ItemsSource="{Binding}"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <!--<DataGridCheckBoxColumn Width="70"
                                        Binding="{Binding IsLiveEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Header="수신" />-->
                <DataGridTemplateColumn Width="70" Header="수신" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsLiveEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="*"
                                    Binding="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Header="Key" />
                <DataGridTextColumn Width="*"
                                    Binding="{Binding Display, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Header="표시명" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox x:Name="KeyBox"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        PlaceholderText="Key" />

            <ui:TextBox x:Name="DisplayBox"
                        Grid.Column="1"
                        Margin="0,0,8,0"
                        PlaceholderText="표시명" />

            <ui:Button Grid.Column="2"
                       Margin="0,0,8,0"
                       Click="AddButton_Click"
                       Content="추가"
                       Icon="{ui:SymbolIcon Add24}" />

            <ui:Button Grid.Column="3"
                       Appearance="Secondary"
                       Click="DeleteButton_Click"
                       Content="삭제"
                       Icon="{ui:SymbolIcon Delete24}" />
        </Grid>

        <TextBlock FontSize="12"
                   Opacity="0.65"
                   Text="적용 후 저장을 선택하면 다음 실행 시에도 같은 타입 설정을 사용합니다." />
    </StackPanel>
</UserControl>
