<Page x:Class="FaceSearchApp.Views.FaceRegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FaceSearchApp.Views"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:FaceSearchApp.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FaceRegistrationPage">

    <Page.Resources>
        <conv:CenterPositionConverter x:Key="CenterPosConverter" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />
    </Page.Resources>

    <Grid Margin="20,12,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top Toolbar -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <!-- Main Video Content -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- ════════ TOP TOOLBAR ════════ -->
        <ui:Card Grid.Row="0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="카메라 / RTSP 주소" FontSize="11" Opacity="0.55" Margin="0,0,0,4"/>
                    <ui:TextBox Text="{Binding RtspUrl, UpdateSourceTrigger=PropertyChanged}" 
                                PlaceholderText="RTSP 주소 입력 (미입력 시 기본 카메라 연결)"/>
                </StackPanel>

                <ui:Button Grid.Column="2" 
                           Content="연결" 
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Symbol=Camera24}"
                           VerticalAlignment="Bottom"
                           Padding="16,6"
                           Command="{Binding StartCameraCommand}"/>

                <ui:Button Grid.Column="4" 
                           Content="중지" 
                           Appearance="Secondary"
                           VerticalAlignment="Bottom"
                           Padding="16,6"
                           Command="{Binding StopCameraCommand}"/>
            </Grid>
        </ui:Card>

        <!-- ════════ MAIN CONTENT (VIDEO) ════════ -->
        <Grid Grid.Row="2">
            <ui:Card Grid.Row="2" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}">
                <Grid Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <!-- 비디오 프레임 -->
                    <Image Source="{Binding VideoFrame}" Stretch="Uniform"/>

                    <!-- 얼굴 탐지 가이드 (Canvas) -->
                    <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Border x:Name="GuideBox" 
                        Width="240" 
                        Height="300"
                        BorderBrush="{Binding GuideColor}" 
                        BorderThickness="3" 
                        CornerRadius="12">

                            <!-- Border.Left 대신 Canvas.Left 사용 -->
                            <Canvas.Left>
                                <MultiBinding Converter="{StaticResource CenterPosConverter}">
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Canvas}"/>
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                                </MultiBinding>
                            </Canvas.Left>

                            <!-- Border.Top 대신 Canvas.Top 사용 -->
                            <Canvas.Top>
                                <MultiBinding Converter="{StaticResource CenterPosConverter}">
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=Canvas}"/>
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                </MultiBinding>
                            </Canvas.Top>
                        </Border>
                    </Canvas>

                    <!-- 연결 중 로딩 오버레이 -->
                    <Border Background="#80000000" CornerRadius="8"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48"/>
                            <TextBlock Text="카메라 연결 중..." Margin="0,12,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ui:Card>
        </Grid>
        <!-- ════════ BOTTOM BAR ════════ -->
        <ui:Card Grid.Row="4" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Info24" Margin="0,0,8,0" Opacity="0.6"/>
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="13"/>
                </StackPanel>

                <!-- 감지 진행률 -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="안면 인식 유지" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,4" Opacity="0.6"/>
                    <ProgressBar Value="{Binding CaptureProgress}" 
                         Maximum="100" 
                         Height="6"
                         VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </ui:Card>
    </Grid>
</Page>
