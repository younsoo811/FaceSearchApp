<Page x:Class="FaceSearchApp.Views.SettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FaceSearchApp.Views"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SettingPage">

    <Grid Margin="40">
        <StackPanel MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock Text="시스템 설정" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

            <ui:Card Padding="16">
                <StackPanel>
                    <TextBlock Text="API 서버 설정" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="안면 인식 API 서버의 주소와 포트를 설정합니다." Opacity="0.6" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0" 
                                    PlaceholderText="IP 주소 (예: localhost)" 
                                    Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                                    />

                        <TextBlock Grid.Column="1" Text=":" VerticalAlignment="Bottom" Margin="8,0,8,12" FontSize="18"/>

                        <ui:TextBox Grid.Column="2" 
                                    PlaceholderText="포트" 
                                    Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                    />
                    </Grid>

                    <ui:Button Content="설정 저장 및 적용" 
                               Appearance="Primary" 
                               Margin="0,24,0,0"
                               Icon="{ui:SymbolIcon Symbol=Save24}"
                               Command="{Binding SaveCommand}"/>
                </StackPanel>
            </ui:Card>

            <TextBlock Text="* 변경된 주소는 앱 재시작 후 또는 다음 요청부터 적용됩니다." 
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Margin="0,12,0,0" FontSize="12"/>
        </StackPanel>
    </Grid>
</Page>
