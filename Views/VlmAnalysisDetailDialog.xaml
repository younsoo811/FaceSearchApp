<UserControl x:Class="FaceSearchApp.Views.VlmAnalysisDetailDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Width="500">
    <ScrollViewer MaxHeight="620"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,4,0,0">
            <Border Margin="0,0,0,14"
                    MaxHeight="340"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    ClipToBounds="True"
                    CornerRadius="8">
                <Grid>
                    <Image Margin="6"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="{Binding Image}"
                           Stretch="Uniform">
                        <Image.ContextMenu>
                            <ContextMenu>
                                <ui:MenuItem Click="SaveImage_Click"
                                             Header="이미지 저장..."
                                             Icon="{ui:SymbolIcon ArrowDownload24}" />
                                <ui:MenuItem Click="CopyImage_Click"
                                             Header="클립보드에 복사"
                                             Icon="{ui:SymbolIcon Copy24}" />
                            </ContextMenu>
                        </Image.ContextMenu>
                    </Image>

                    <Border Margin="0,10,10,0"
                            Padding="12,6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{Binding FireBorderBrush}"
                            CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFireMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FireLabel}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="{Binding FireLabel}" />
                    </Border>
                </Grid>
            </Border>

            <TextBlock Margin="0,0,0,12"
                       FontSize="11"
                       Opacity="0.5"
                       TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Timestamp}" />
                <Run Text="  ·  " />
                <Run Text="{Binding ImageInfo}" />
            </TextBlock>

            <Border Margin="0,0,0,12"
                    Padding="14,10"
                    Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                    CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Result}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Margin="0,0,0,8"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Opacity="0.7"
                               Text="{Binding ResultTitle}" />
                    <TextBlock FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="{Binding Result}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,12"
                    Padding="14,10"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{Binding ConfidenceBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasConfidence}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="10" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Opacity="0.7"
                                   Text="신뢰도" />
                        <TextBlock Grid.Column="1"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{Binding ConfidenceBrush}"
                                   Text="{Binding ConfidenceDisplay}" />
                    </Grid>

                    <ProgressBar Grid.Row="2"
                                 Height="10"
                                 Maximum="100"
                                 Background="{Binding ConfidenceTrackBrush}"
                                 Foreground="{Binding ConfidenceBrush}"
                                 Value="{Binding AnimatedConfidencePercent}" />
                </Grid>
            </Border>

            <Border Padding="14,10"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Description}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Margin="0,0,0,8"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Opacity="0.6"
                               Text="이미지 설명" />
                    <TextBlock FontSize="13"
                               LineHeight="22"
                               Text="{Binding Description}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
