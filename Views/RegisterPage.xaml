<Page x:Class="FaceSearchApp.Views.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:FaceSearchApp.Converters"
      Title="이미지 등록"
      Background="Transparent">

    <Page.Resources>
        <conv:BoolToVisibilityConverter         x:Key="BoolVis" />
        <conv:InverseBoolToVisibilityConverter  x:Key="InvBoolVis" />
        <conv:NullToVisibilityConverter         x:Key="NullVis" />
        <conv:NotNullToVisibilityConverter      x:Key="NotNullVis" />
    </Page.Resources>

    <!-- Center content -->
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
          Width="660">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <!-- ════════════════════════════════════
             LEFT: Image Preview
             ════════════════════════════════════ -->
        <ui:Card Grid.Column="0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="360" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="8,8,0,0"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        Padding="14,10">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PersonAdd24" Margin="0,0,8,0"/>
                        <TextBlock Text="등록할 이미지" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Drop Zone -->
                <Border Grid.Row="1"
                        Margin="12"
                        CornerRadius="8"
                        BorderThickness="2"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        AllowDrop="True"
                        Drop="DropZone_Drop"
                        DragOver="DropZone_DragOver"
                        DragLeave="DropZone_DragLeave"
                        MouseLeftButtonDown="DropZone_Click"
                        Cursor="Hand"
                        x:Name="DropZone">
                    <Grid>
                        <!-- Preview image -->
                        <Image Source="{Binding PreviewImage}"
                               Stretch="Uniform"
                               Visibility="{Binding PreviewImage, Converter={StaticResource NullVis}}"/>

                        <!-- Placeholder -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding PreviewImage, Converter={StaticResource NotNullVis}}">
                            <ui:SymbolIcon Symbol="ImageAdd24" FontSize="64" Opacity="0.3"
                                           HorizontalAlignment="Center"/>
                            <TextBlock Text="이미지를 드래그하거나 클릭" FontSize="14"
                                       Opacity="0.55" Margin="0,14,0,4"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="JPG · PNG · BMP · WEBP" FontSize="11"
                                       Opacity="0.35" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Image info -->
                <TextBlock Grid.Row="2"
                           Text="{Binding ImageInfo}"
                           FontSize="11" Opacity="0.55"
                           HorizontalAlignment="Center"
                           Margin="12,0,12,6"
                           Visibility="{Binding PreviewImage, Converter={StaticResource NullVis}}"/>

                <!-- File select button -->
                <Button Grid.Row="3"
                        Content="파일 선택"
                        HorizontalAlignment="Center"
                        Padding="24,7"
                        Margin="12,0,12,14"
                        Click="SelectFile_Click"/>
            </Grid>
        </ui:Card>

        <!-- ════════════════════════════════════
             RIGHT: Options & Result
             ════════════════════════════════════ -->
        <ui:Card Grid.Column="2" Padding="0">
            <StackPanel>

                <Border CornerRadius="8,8,0,0"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        Padding="14,10" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Options24" Margin="0,0,8,0"/>
                        <TextBlock Text="등록 옵션" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Margin="16,0,16,16">

                    <!-- Image Type -->
                    <TextBlock Text="저장 대상 컬렉션" FontSize="12" Opacity="0.65" Margin="0,0,0,8"/>
                    <Border CornerRadius="6" BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Padding="10,10" Margin="0,0,0,20">
                        <StackPanel>
                            <RadioButton Content="일반 (FaceVectors)"
                                         IsChecked="{Binding IsNormalType}"
                                         FontSize="12" Margin="0,0,0,8"/>
                            <RadioButton Content="타깃 (TargetVectors)"
                                         IsChecked="{Binding IsTargetType}"
                                         FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Register Button -->
                    <ui:Button Content="등록"
                               Appearance="Primary"
                               HorizontalAlignment="Stretch"
                               Padding="0,10"
                               Command="{Binding UploadCommand}"
                               Icon="{ui:SymbolIcon Symbol=CloudArrowUp24}"
                               Margin="0,0,0,8"/>

                    <Button Content="초기화"
                            HorizontalAlignment="Stretch"
                            Padding="0,8"
                            Command="{Binding ClearCommand}"
                            Margin="0,0,0,16"/>

                    <Separator Margin="0,0,0,16" Opacity="0.3"/>

                    <!-- Progress -->
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="28" Height="28"
                                     HorizontalAlignment="Center"
                                     Margin="0,0,0,8"
                                     Visibility="{Binding IsUploading, Converter={StaticResource BoolVis}}"/>

                    <!-- Status Message -->
                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Opacity="0.75"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <!-- Success Result -->
                    <Border CornerRadius="6"
                            Background="#1A4CAF50"
                            BorderBrush="#4CAF50"
                            BorderThickness="1"
                            Padding="10,8"
                            Visibility="{Binding IsSuccess, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        Margin="0,0,0,4">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                               Foreground="#4CAF50" Margin="0,0,6,0"/>
                                <TextBlock Text="등록 완료" Foreground="#4CAF50"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LastResult}"
                                       FontSize="11" Opacity="0.7"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center"
                                       ToolTip="{Binding LastResult}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ui:Card>
    </Grid>
</Page>
